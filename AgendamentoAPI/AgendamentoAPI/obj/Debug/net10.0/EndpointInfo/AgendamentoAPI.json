          "telefone"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "minLength": 1,
            "type": "string"
          },
          "disponivel": {
            "type": "boolean"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "senha": {
            "minLength": 6,
            "type": "string"
          },
          "telefone": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ServicoDTO": {
        "required": [
          "duracaoMinutos",
          "nome",
          "preco"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string"
          },
          "descricao": {
            "type": "string",
            "nullable": true
          },
          "duracaoMinutos": {
            "maximum": 1440,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "preco": {
            "maximum": 10000,
            "minimum": 0,01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    },
